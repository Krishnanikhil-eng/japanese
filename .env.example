# Japanese Learning Companion — Environment Variables
# Copy this file to .env.local and fill in the values.

# ============================================================
# AI Teacher (Optional)
# The app works fully without these. Only needed for AI features.
# ============================================================

# OpenAI API key for AI Teacher
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# JLPT Configuration
# ============================================================

# Target JLPT test date (ISO format)
# Default: 2026-12-06 (December 6, 2026)
NEXT_PUBLIC_JLPT_TARGET_DATE=2026-12-06

# Target JLPT level
NEXT_PUBLIC_JLPT_LEVEL=N5
