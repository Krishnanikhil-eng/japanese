      "Name the days of the week",
      "Conjugate verbs into -ます, -ません, -ました, and -ませんでした",
      "Mark point-in-time actions with particle に",
      "State starting and ending times using から and まで"
    ],
    "vocabularyCount": 16,
    "grammarPoints": [
      "今 〜時 〜分 です (It is currently ~:~~)",
      "V ます / V ません (Non-past affirmative / negative)",
      "V ました / V ませんでした (Past affirmative / negative)",
      "N(time) に V (Action at specific numerical time)",
      "N1 から N2 まで (From N1 to N2)"
    ]
  },
