{
  "lesson": {
    "id": "lesson-02",
    "number": 2,
    "title": "Objects, Demonstratives & Possession",
    "titleJa": "第2課 物と指示詞・所有",
    "topic": "Demonstratives (kore/sore/are), everyday items, and stating ownership",
    "status": "available",
    "description": "Learn demonstrative pronouns and demonstrative noun modifiers to identify nearby and distant objects and their owners.",
    "objectives": [
      "Distinguish spatial distance using これ (near speaker), それ (near listener), and あれ (far from both)",
      "Use noun-modifying demonstratives この N, その N, and あの N",
      "Express agreement or disagreement with そうです and 違います",
      "Ask and answer questions about possession using だれの"
    ],
    "vocabularyCount": 16,
    "grammarPoints": [
      "これ / それ / あれ は N です (This / That is N)",
      "この N / その N / あの N (This N / That N)",
      "そうです / そうじゃありません (That is so / That is not so)",
      "S1 か、S2 か (Alternative questions: Is it S1 or S2?)",
      "N1 の N2 (Possession / Ownership: Whose N2 is it?)"
    ]
  },
  "concepts": [
    {
      "id": "concept-02-01",
      "lessonId": "lesson-02",
      "type": "grammar",
      "title": "Demonstrative Pronouns (これ・それ・あれ)",
      "titleJa": "これ・それ・あれ",
      "description": "Used as standalone noun pronouns based on relative distance to speaker and listener.",
      "examples": [
        {
          "japanese": "これは本です。",
          "reading": "これはほんです。",
          "english": "This is a book (near me)."
        },
        {
          "japanese": "それは辞書ですか。",
          "reading": "それはじしょですか。",
          "english": "Is that a dictionary (near you)?"
        },
        {
          "japanese": "あれは時計です。",
          "reading": "あれはとけいです。",
          "english": "That over there is a clock."
        }
      ],
      "prerequisites": ["concept-01-01"]
    },
    {
      "id": "concept-02-02",
      "lessonId": "lesson-02",
      "type": "grammar",
      "title": "Demonstrative Noun Modifiers (この・その・あの)",
      "titleJa": "この N・その N・あの N",
      "description": "Must immediately precede a noun to modify it directly.",
      "examples": [
        {
          "japanese": "この傘はわたしのです。",
          "reading": "このかさはわたしのです。",
          "english": "This umbrella is mine."
        },
        {
          "japanese": "その鍵はだれのですか。",
          "reading": "そのかぎはだれのですか。",
          "english": "Whose key is that?"
        }
      ],
      "prerequisites": ["concept-02-01"]
    },
    {
      "id": "concept-02-03",
      "lessonId": "lesson-02",
      "type": "grammar",
      "title": "Confirming with そうです and 違います",
      "titleJa": "そうです・違います",
      "description": "Polite expressions used to affirm or deny questions about noun identity.",
      "examples": [
        {
          "japanese": "はい、そうです。",
          "reading": "はい、そうです。",
          "english": "Yes, that is right."
        },
        {
          "japanese": "いいえ、違います。手帳です。",
          "reading": "いいえ、ちがいます。てちょうです。",
          "english": "No, it's not. It is a pocket notebook."
        }
      ],
      "prerequisites": ["concept-01-03"]
    }
  ],
