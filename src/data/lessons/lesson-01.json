{
  "lesson": {
    "id": "lesson-01",
    "number": 1,
    "title": "Introductions & Basic Identity",
    "titleJa": "第1課 自己紹介と身元",
    "topic": "Self-introductions, nationalities, professions, and basic statements",
    "status": "available",
    "description": "Learn how to state names, nationalities, and occupations using the basic copula pattern N1 は N2 です.",
    "objectives": [
      "Introduce yourself politely using はじめまして and よろしくお願いします",
      "Form affirmative and negative identity statements with です and じゃありません",
      "Ask question sentences ending in the particle か",
      "Express shared identity using the particle も (also/too)",
      "Connect nouns with the possessive/attributive particle の"
    ],
    "vocabularyCount": 16,
    "grammarPoints": [
      "N1 は N2 です (N1 is N2)",
      "N1 は N2 じゃありません (N1 is not N2)",
      "N1 は N2 ですか (Is N1 N2?)",
      "N も (Also / Too)",
      "N1 の N2 (N1's N2 / N2 of N1)"
    ]
  },
  "concepts": [
    {
      "id": "concept-01-01",
      "lessonId": "lesson-01",
      "type": "grammar",
      "title": "Noun Predicate Affirmative (は ... です)",
      "titleJa": "N1 は N2 です",
      "description": "Particle は indicates the topic of the sentence. です serves as a polite copula expressing state of being (is/am/are).",
      "examples": [
        {
          "japanese": "わたしは学生です。",
          "reading": "わたしはがくせいです。",
          "english": "I am a student.",
          "notes": "は is pronounced 'wa' when used as a topic marker."
        },
        {
          "japanese": "サントスさんは会社員です。",
          "reading": "サントスさんはかいしゃいんです。",
          "english": "Mr. Santos is a company employee."
        }
      ],
      "prerequisites": []
    },
    {
      "id": "concept-01-02",
      "lessonId": "lesson-01",
      "type": "grammar",
      "title": "Noun Predicate Negative (じゃありません)",
      "titleJa": "N1 は N2 じゃありません",
      "description": "じゃありません (or ではありません in formal writing) negates です.",
      "examples": [
        {
          "japanese": "わたしは医者じゃありません。",
          "reading": "わたしはいしゃじゃありません。",
          "english": "I am not a doctor."
        }
      ],
      "prerequisites": ["concept-01-01"]
    },
    {
      "id": "concept-01-03",
      "lessonId": "lesson-01",
      "type": "grammar",
      "title": "Question Sentence with か",
      "titleJa": "S か",
      "description": "Adding か at the end of a sentence creates a polite question without changing word order.",
      "examples": [
        {
          "japanese": "ミラさんはアメリカ人ですか。",
          "reading": "ミラさんはアメリカじんですか。",
          "english": "Is Mr. Miller American?"
        }
      ],
      "prerequisites": ["concept-01-01"]
    },
    {
      "id": "concept-01-04",
      "lessonId": "lesson-01",
      "type": "particle",
      "title": "Inclusion Particle も (Also/Too)",
      "titleJa": "助詞「も」",
      "description": "Replaces the topic marker は when the predicate applies to this noun as well.",
      "examples": [
        {
          "japanese": "山田さんも先生です。",
          "reading": "やまださんもせんせいです。",
          "english": "Ms. Yamada is also a teacher."
        }
      ],
      "prerequisites": ["concept-01-01"]
    },
    {
      "id": "concept-01-05",
      "lessonId": "lesson-01",
      "type": "particle",
      "title": "Noun Modifier Particle の",
      "titleJa": "助詞「の」",
      "description": "Connects two nouns, where N1 modifies or specifies N2 (possession, affiliation, category).",
      "examples": [
        {
          "japanese": "わたしはIMCの社員です。",
          "reading": "わたしはIMCのしゃいんです。",
          "english": "I am an employee of IMC."
        }
      ],
      "prerequisites": ["concept-01-01"]
    }
  ],
